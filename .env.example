# Copy to .env and fill in your own values. Never commit a real .env.

# Server
PORT=3000
NODE_ENV=development

# Frontend origins (comma-separated allowed; used for CORS)
ORIGIN="http://localhost:5173"
ALTORIGIN="http://localhost:4173/"
DOMAIN="neopromisance.com"

# Database
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=promisance

# PostgreSQL container init (docker-compose)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=promisance

# Auth / secrets
JWT_SECRET=changeme
CRON_SECRET=changeme
LINK_SECRET=changeme
GAME_RESET=changeme

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
SEND_GRID=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
MY_EMAIL=

# Sentry runtime reporting. Leave blank to disable (no events are sent).
# This is read by Sentry.init() in src/index.ts. Use your OWN private DSN.
SENTRY_DSN=

# Sentry source-map upload (only needed for `npm run sentry`)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
